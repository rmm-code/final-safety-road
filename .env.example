# ---------------------------------------------------------------------------
# Pothole Intelligence - example environment
# Copy to apps/web/.env.local for the web app. Never commit real secrets.
# ---------------------------------------------------------------------------

# Vision engine selection for the browser.
#   auto   - use ONNX when a model manifest is reachable, otherwise mock
#   onnx   - force ONNX (fails loudly when the model is missing)
#   server - force the server inference adapter
#   mock   - force the deterministic synthetic engine
NEXT_PUBLIC_VISION_ENGINE=auto

# Location of the model manifest served from apps/web/public/models.
NEXT_PUBLIC_MODEL_MANIFEST_URL=/models/model.json

# Directory that serves the onnxruntime-web .wasm binaries.
# Populate it with: npm run sync:ort-runtime --workspace @pothole/web
NEXT_PUBLIC_ORT_WASM_PATH=/ort/

# ONNX Runtime log severity: verbose | info | warning | error | fatal.
# "error" by default. ORT writes warnings to console.error, so at "warning" a benign
# execution-provider note shows up in the Next.js dev overlay as a page error.
NEXT_PUBLIC_ORT_LOG_LEVEL=error

# --- Hackathon demo -----------------------------------------------------------
# Serve the internal console with nobody signed in.
#
# The console's login page is parked for now (apps/web/app/(console)/_login), so with this
# off every authenticated call answers 401 and the map, dashboard and review queue all
# render as errors. Nothing is removed by the flag: a presented token is still verified,
# every route still resolves a real user, and role checks still run. It only decides what
# happens when NO credentials arrive.
#
# The API REFUSES TO START with this true and ENVIRONMENT=production.
AUTH_DISABLED=false
# The account unauthenticated requests act as while the flag is on. Created on first use
# with a random password nobody holds, so it cannot also be signed into.
DEMO_USER_EMAIL=demo@example.com

# --- Telegram reporting -------------------------------------------------------
# PARTLY PARKED: only the webhook route is commented out in apps/api/app/api/v1/__init__.py
# for the hackathon. The rest still reads these settings - TELEGRAM_BOT_USERNAME drives the
# report button on /live, and the Mini App submit route checks the token.
# All optional: the API and the console run without them, and every Telegram route
# answers 503 while unset. Create the bot with @BotFather, which issues the token.
# NEVER commit a real token.
TELEGRAM_BOT_TOKEN=
# Without the @. Used to build the t.me deep link the public map's button opens.
TELEGRAM_BOT_USERNAME=
# Telegram echoes this back in X-Telegram-Bot-Api-Secret-Token, and it is the only thing
# authenticating the webhook - the URL itself has to be public. `openssl rand -hex 32`.
TELEGRAM_WEBHOOK_SECRET=

# Where the public map lives. The bot links here after accepting a report.
PUBLIC_WEB_URL=http://localhost:3000

# Independent reporters needed before an unverified pothole is shown as confirmed.
# Counted per person, so nobody can confirm their own report.
CITIZEN_CONFIRMATIONS_TO_VERIFY=3
# Hold citizen photos back from the public map until an operator has seen them.
# Leave true unless you are comfortable publishing whatever strangers upload.
CITIZEN_IMAGES_REQUIRE_REVIEW=true

# Cap for unauthenticated routes, per IP per minute. Much tighter than the authenticated
# limit, which is sized for a fleet of phones uploading sightings.
PUBLIC_RATE_LIMIT_PER_MINUTE=60

# Endpoint for ServerVisionEngine. Empty until the inference service exists (Milestone 4+).
NEXT_PUBLIC_SERVER_VISION_URL=

# Frames per second sampled from an uploaded video during analysis.
# Higher than the live drive rate on purpose: analysing a file is offline, so sampling
# more often costs only time and measurably finds more potholes.
NEXT_PUBLIC_ANALYZE_SAMPLE_FPS=12

# ---------------------------------------------------------------------------
# Backend (Milestone 4+). Copy to .env at the repository root for Docker Compose.
# ---------------------------------------------------------------------------

# Required, no default. Generate with: openssl rand -hex 32
JWT_SECRET=

# Browser origins allowed to call the API. Never "*" - the API is credentialed.
# Both local dev ports: Next falls back to 3001 when 3000 is taken. Add the Mini App's
# public HTTPS origin here when deploying - a Mini App is an ordinary cross-origin page.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Postgres is published on 5433 to avoid colliding with a local install on 5432.
DATABASE_URL=postgresql+asyncpg://pothole:pothole@localhost:5433/pothole

S3_ENDPOINT_URL=http://localhost:9000
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=pothole-evidence

# Deduplication. Sightings inside this radius are candidates for the same defect.
DEDUP_RADIUS_M=10
DEDUP_MAX_RADIUS_M=35
DEDUP_MERGE_THRESHOLD=0.55

# The browser reaches the API on the web app's own origin: next.config.ts rewrites
# /api/v1 to API_INTERNAL_URL (default http://localhost:8000). Never point the client at
# localhost:8000 directly - on a phone that is the phone.
# API_INTERNAL_URL=http://localhost:8000
